# Groq — Consultant Terminal
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# SpaceXAI / xAI — used only for reasoning, chat, grading, and question generation.
# Search embeddings run locally by default so the 16GB Mac stays responsive.
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# Optional fallback if you do not have an xAI key:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# local = MiniLM on-device (default, RAM-safe)
# xai   = xAI embeddings API (model v1)
# hash  = no-download hashing encoder (tests / offline smoke)
EMBEDDING_BACKEND=local
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2
XAI_EMBED_MODEL=v1

# Optional override. Default is <repo>/data
# MLE_DATA_DIR=
