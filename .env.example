# ---- LLM provider — Consultant Terminal (Plan 03) ---------------------------
# Active provider: groq | openai | anthropic | local (default groq).
# The Consultant UI can override this per request; LLM_PROVIDER is the default.
LLM_PROVIDER=groq

# groq (default)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# local = llama.cpp (or any OpenAI-compatible server) — no key needed
LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL=local
# LOCAL_API_KEY=

# SpaceXAI / xAI — legacy pipeline variables (reasoning / embeddings).
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# local = MiniLM on-device (default, RAM-safe)
# xai   = xAI embeddings API (model v1)
# hash  = no-download hashing encoder (tests / offline smoke)
EMBEDDING_BACKEND=local
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2
XAI_EMBED_MODEL=v1

# Optional override. Default is <repo>/data
# MLE_DATA_DIR=

# 1 = seed sample papers on startup (Consultant key is entered per-request on
# the Consultant/Settings pages — never persisted server-side).
# MLE_DEMO_MODE=

# --- Hosting (defaults are baked into the Docker image; override to taste) ---
# API_PREFIX=/api            # mount the API under a sub-path (reverse proxy)
# MLE_WEB_ROOT=/app/web      # static Next.js export dir (same-origin UI)
# MLE_DATA_DIR=/data         # SQLite + embeddings live here (volume mount)
# PORT=8000                  # uvicorn bind port
