# Never bake secrets or local state into the image.
.git
.gitignore
.venv
venv/
__pycache__/
*.pyc
.pytest_cache/
.env
.streamlit/secrets.toml
data/
*.db
*.db-journal
docs/pulse/
# Frontend build artifacts / deps are rebuilt inside the image (stage 1).
frontend/node_modules/
frontend/.next/
frontend/out/
# Test/CI scratch.
frontend/test-results/
frontend/coverage/
